PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/fmcg_ordering_app
JWT_SECRET=replace_with_a_long_random_secret

# Gemini text order interpretation. Keep this key on the server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Meta WhatsApp Cloud API
WHATSAPP_API_VERSION=v27.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose_a_long_random_webhook_token
WHATSAPP_STATUS_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
